# PostgreSQL connection string (Neon, Supabase, or local Docker Postgres)
DATABASE_URL="postgresql://user:password@host:5432/velozity?schema=public"

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"

# Token lifetimes
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# Server
PORT=4000
NODE_ENV="development"

# Comma-separated list of allowed frontend origins (for CORS + cookie settings)
CLIENT_ORIGIN="http://localhost:5173"
