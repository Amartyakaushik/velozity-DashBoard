// Velozity Global Solutions — Client Project Dashboard
// Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PM
  DEVELOPER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_IN_REVIEW
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())

  // Refresh tokens are stored server-side (rotated + revocable), not just trusted from the cookie.
  refreshTokens   RefreshToken[]
  projectsCreated Project[]        @relation("ProjectManager")
  tasksAssigned   Task[]           @relation("AssignedDeveloper")
  activityEvents  ActivityLog[]    @relation("ActivityActor")
  notifications   Notification[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Client {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  pmId        String
  pm          User     @relation("ProjectManager", fields: [pmId], references: [id])
  createdAt   DateTime @default(now())

  tasks          Task[]
  activityEvents ActivityLog[]

  // PMs frequently filter "my projects"; Admin lists all.
  @@index([pmId])
  @@index([clientId])
}

model Task {
  id                 String       @id @default(uuid())
  number             Int          @unique @default(autoincrement()) // human-facing "Task #12" label
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  assignedDeveloperId String?
  assignedDeveloper  User?        @relation("AssignedDeveloper", fields: [assignedDeveloperId], references: [id])
  status             TaskStatus   @default(TODO)
  priority           TaskPriority @default(MEDIUM)
  dueDate            DateTime?
  isOverdue          Boolean      @default(false) // set by the node-cron scheduled job, never on read
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  activityEvents ActivityLog[]
  notifications  Notification[]

  // Every list view filters/sorts by these — index them.
  @@index([projectId])
  @@index([assignedDeveloperId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([isOverdue])
}

model ActivityLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actorId   String
  actor     User     @relation("ActivityActor", fields: [actorId], references: [id])
  action    String   // e.g. "STATUS_CHANGE"
  fromValue String?
  toValue   String?
  message   String   // precomputed human-readable line, e.g. "Ravi moved Task #12 from In Progress to In Review"
  createdAt DateTime @default(now())

  // The feed always queries "events for project X after timestamp Y" or "last 20 for project X" — both need this composite index.
  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([actorId])
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  type      NotificationType
  message   String
  read      Boolean           @default(false)
  createdAt DateTime          @default(now())

  // Notification dropdown queries "unread for user, newest first" constantly.
  @@index([userId, read])
  @@index([userId, createdAt])
}
